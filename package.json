{
  "name": "chessonglass",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "ChessOnGlass: a local-first, cross-platform chess assistant.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-workspaces.mjs",
    "typecheck": "tsc -b tsconfig.build.json --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:engine": "vitest run --config vitest.engine.config.ts",
    "test:native": "vitest run --config vitest.native.config.ts",
    "test:e2e": "vitest run packages/app/test/runtime/windows-application.test.ts",
    "test:cloud-smoke": "vitest run packages/app/test/providers/offline-cloud-smoke.test.ts",
    "check:brand": "node scripts/check-brand.mjs",
    "eval": "npm run build && node packages/game/dist/cli-evaluate.js"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
